# Backend configuration
# Copy this file to .env and adjust values for your environment.
# Never commit .env to source control.

# SQLite for development and demo. To switch to PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/newsfeed
DATABASE_URL=sqlite+aiosqlite:///./newsfeed.db

# Set to true to echo all SQL queries to stdout (development only)
DEBUG=false

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Set to false if behind a corporate proxy that performs SSL inspection
SSL_VERIFY=false
